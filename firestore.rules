// Firestore security rules for the Star Jar sync, kept here so the
// shape the app needs is written down next to the code that needs it.
// They are NOT applied automatically — paste them into the Firebase
// console (Firestore Database → Rules → Publish) when they change.
//
// The security model is the family code itself: anyone who knows a
// code can read and write that family's data, which is the same trade
// the app makes everywhere else. Star counts aren't sensitive, and
// this avoids real accounts and passwords for a kids' app. Signing in
// (anonymously, silently) is still required, so a request with no auth
// at all gets nothing.
//
// The grown-up PIN lives on the family document as a salted hash, and
// these rules let anyone with the code read it. That is deliberate and
// the PIN is designed around it: it stops a kid tapping "add stars",
// not someone determined. It is hashed only so a PIN a parent also
// uses elsewhere isn't sitting in the database as typed.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything a family owns: the family document itself, its kids,
    // each kid's star ledger, and the family's reward list. The
    // recursive wildcard means new subcollections don't need a rules
    // change to start working.
    match /families/{familyCode}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
